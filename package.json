{
  "name": "gestor-rutas-ada",
  "private": true,
  "version": "1.0.0",
  "description": "Gestor de Rutas de Transporte: proyecto de Análisis y Diseño de Algoritmos I, Universidad del Valle – Sede Pacífico, 2026-2",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "node scripts/check.mjs",
    "bench": "node --expose-gc --import tsx bench/ejecutar.ts",
    "cli": "tsx src/cli/principal.ts",
    "capturas": "node scripts/capturas.mjs",
    "informe": "tsx informe/construir.ts final",
    "informe:fase1": "tsx informe/construir.ts fase1",
    "entrega": "node scripts/entrega.mjs",
    "limpiar": "rimraf dist coverage"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "framer-motion": "^14.10.1",
    "lucide-react": "^1.70.0",
    "qrcode-generator": "2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/archiver": "^8.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "archiver": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsqr": "1.4.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
